{
  "name": "build-monitor-plugin",
  "version": "1.0.0",
  "description": "Build Monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "mvnbuild": "npm run build",
    "mvntest": "npm run test",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode production --watch",
    "lint:fix": "prettier --write src/main/frontend/ && eslint --fix src/main/frontend/",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jenkinsci/build-monitor-plugin.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jenkinsci/build-monitor-plugin/issues"
  },
  "dependencies": {
    "@tippyjs/react": "4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-formatter-checkstyle": "9.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "30.0.1",
    "neostandard": "0.13.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.102.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
