{
  "name": "build-monitor-plugin",
  "version": "1.0.0",
  "description": "Build Monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "mvnbuild": "npm run build",
    "mvntest": "npm run test",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode production --watch",
    "lint:fix": "prettier --write src/main/frontend/ && eslint --fix src/main/frontend/",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jenkinsci/build-monitor-plugin.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jenkinsci/build-monitor-plugin/issues"
  },
  "dependencies": {
    "@tippyjs/react": "4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "30.1.0",
    "neostandard": "0.13.0",
    "prettier": "3.9.8",
    "sass-embedded": "1.104.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
